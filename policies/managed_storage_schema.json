{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PHIS Sentinel Managed Policy",
  "type": "object",
  "properties": {
    "strictMode": {
      "type": "boolean",
      "description": "Enable strict phishing weighting."
    },
    "maxModelLatencyMs": {
      "type": "integer",
      "minimum": 50,
      "maximum": 2000,
      "description": "Maximum local model inference budget."
    },
    "blockCriticalLinks": {
      "type": "boolean",
      "description": "Disable click-through for critical detections."
    },
    "adminMode": {
      "type": "boolean",
      "description": "Enables additional diagnostics and policy lock." 
    }
  },
  "additionalProperties": false
}
